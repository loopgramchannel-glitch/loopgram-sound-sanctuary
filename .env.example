# Placeholders only. Real values live in Lovable → Project Settings → Secrets (server-only).
# Public (safe in the browser)
VITE_ALGOLIA_APP_ID=<algolia-app-id>
VITE_ALGOLIA_SEARCH_API_KEY=<algolia-search-only-key>
VITE_TURNSTILE_SITE_KEY=<turnstile-site-key>
GOOGLE_API_KEY=<firebase-web-api-key>
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
FIREBASE_APP_ID=<firebase-app-id>
FIREBASE_MESSAGING_SENDER_ID=<sender-id>
FIREBASE_STORAGE_BUCKET=<bucket>

# Secret (server only — never prefix with VITE_)
TMDB_READ_ACCESS_TOKEN=<tmdb-v4-read-token>
