ALGOLIA_ADMIN_API_KEY=<algolia-admin-key>
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_ZONE_ID=<zone-id>
CLOUDFLARE_API_TOKEN=<scoped-api-token>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<bucket>
R2_PUBLIC_URL=https://<public-media-host>
R2_ACCESS_KEY_ID=<r2-key>
R2_SECRET_ACCESS_KEY=<r2-secret>
TURNSTILE_SECRET_KEY=<turnstile-secret>
FIREBASE_CLIENT_EMAIL=<sa@project.iam.gserviceaccount.com>
FIREBASE_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----...>
OWNER_UID=<firebase-owner-uid>
SEARCH_SYNC_SECRET=<random-long-string>
